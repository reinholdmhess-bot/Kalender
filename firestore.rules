rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Öffentliche Events - lesen für alle, schreiben für authentifizierte Nutzer
    match /publicEvents/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Benutzer-spezifische Events - nur für den jeweiligen Nutzer
    match /users/{userId}/events/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}